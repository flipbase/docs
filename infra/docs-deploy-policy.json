{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTheBucketForSyncDiff",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::docs.flipbase.com"
    },
    {
      "Sid": "WriteTheSite",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::docs.flipbase.com/*"
    },
    {
      "Sid": "InvalidateTheDistribution",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation"
      ],
      "Resource": "arn:aws:cloudfront::435557921244:distribution/E371TMZJQHNA9D"
    }
  ]
}
